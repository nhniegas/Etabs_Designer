           <property name="styleSheet">
            <string notr="true">QPushButton {
    border: none;             /* No button border */
    background: transparent;  /* No grey background */
    text-align: center;         /* Align text like a label */
    padding: 5px;
}
QPushButton:hover {
    /* Hover State: Very light gray/almost white */
    background-color: #f5f5f5; 
    border: 1px solid #cccccc;
    /* Change text to dark gray so it's visible on the light background */
    color: #333333; 
}

QPushButton:pressed {
    /* Pressed State: Standard mid-gray */
    background-color: #d0d0d0; 
    color: #000000;
}

</string>
