                 <property name="styleSheet">
                  <string notr="true">/* Make the default internal box invisible so it doesn't clash */
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid black;
    background-color: white;
}

/* When checked, we just change the box background slightly */
QCheckBox::indicator:checked {
    background-color: #f0f0f0; 
    image: none; /* Ensure no broken red hatch shows up */
}

/* Style the text (the Label part) to look like a checkmark */
QCheckBox {
    font-size: 16px;
    color: black;
    /* This 'pulls' the checkmark character into the box area */
    spacing: -17px; 
    padding-left: 2px;
}</string>
