                 <string notr="true">QPushButton {
    /* Lighter grey background to match the window theme */
    background-color: #f0f0f0; 
    /* Subtle border to match the QListWidget headers */
    border: 1px solid #dcdcdc; 
    border-radius: 4px;
    /* Darker text for readability on light background */
    color: #333333; 
    padding: 6px;
    font-size: 11px;
}

QPushButton:hover {
    /* Lighter, softer red for the light theme */
    background-color: #ef9a9a; 
    border: 1px solid #e57373;
    color: #333333; /* Switching to dark text for better contrast on light red */
}

QPushButton:pressed {
    /* Slightly deeper red when clicked */
    background-color: #ee5253; 
}</string>
