           <string notr="true">border: 1px solid #A0A0A0; /* A thin, solid gray border */
border-radius: 4px;        /* Optional: Rounds the corners slightly */
padding: 4px;              /* Optional: Adds space between text and border */

   /* 1. The Font Chain: Try Consolas first, fail over to Courier New */
   font-family: &quot;Consolas&quot;, &quot;Courier New&quot;, monospace;
    
   /* 2. Size: Logs are usually slightly smaller than normal text */
   font-size: 10pt; 
